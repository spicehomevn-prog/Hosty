{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cal/:token", "destination": "/api/ical-out?k=:token" }
  ],
  "functions": {
    "api/finance.js": {
      "maxDuration": 300
    },
    "api/notify.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/finance?cron=ota",
      "schedule": "0 0 1 * *"
    }
  ]
}

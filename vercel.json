{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/cal/:token",
      "destination": "/api/ical-out?k=:token"
    },
    { "source": "/chinh-sach-bao-mat", "destination": "/index.html" },
    { "source": "/dieu-khoan", "destination": "/index.html" }
  ],
  "functions": {
    "api/finance.js": {
      "maxDuration": 300
    },
    "api/notify.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/finance?cron=ota",
      "schedule": "0 0 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
